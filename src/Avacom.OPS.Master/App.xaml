<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avacom.OPS.Master.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#18181B</Color>
            <Color x:Key="Muted">#52525B</Color>
            <Color x:Key="Primary">#E5262B</Color>
            <Color x:Key="Info">#01A4E1</Color>
            <Color x:Key="Success">#019D60</Color>
            <Color x:Key="Warning">#F3C701</Color>
            <Color x:Key="Danger">#C82230</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="SoftSurface">#F5FAFB</Color>
            <Color x:Key="Line">#DCE8EB</Color>
            <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E9F6FA" Offset="0" />
                <GradientStop Color="#F1F7F3" Offset="0.52" />
                <GradientStop Color="#FBF8E7" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontFamily" Value="Geist" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="PlaceholderColor" Value="#71717A" />
                <Setter Property="FontFamily" Value="Geist" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="PlaceholderColor" Value="#71717A" />
                <Setter Property="FontFamily" Value="Geist" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.4" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>
            <Style x:Key="SoftCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="Stroke" Value="#F7FFFFFF" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="StrokeShape"><RoundRectangle CornerRadius="22" /></Setter>
                <Setter Property="Shadow"><Shadow Brush="#547082" Offset="8,10" Radius="22" Opacity="0.14" /></Setter>
            </Style>
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#F5F9FA" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,3" />
                <Setter Property="StrokeShape"><RoundRectangle CornerRadius="16" /></Setter>
            </Style>
            <Style x:Key="SoftButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Geist" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinimumHeightRequest" Value="64" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="Padding" Value="24,14" />
                <Setter Property="Shadow"><Shadow Brush="#5C6870" Offset="6,8" Radius="16" Opacity="0.18" /></Setter>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="Scale" Value="1" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="Scale" Value="1.015" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Scale" Value="0.97" /><Setter Property="Opacity" Value="0.88" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.42" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="BorderColor" Value="{StaticResource Line}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Geist" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BackgroundColor" Value="#00FFFFFF" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
