<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Avacom.OPS.Master</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <ApplicationTitle>AVACOM OPS Master</ApplicationTitle>
    <ApplicationId>com.avacom.ops.master</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!--
      El panel del profesor se distribuye sin empaquetar: es un .exe que se copia y
      se ejecuta, sin certificado ni instalación. El modo kiosco (Assigned Access)
      sólo aplica a los dispositivos de los estudiantes, no al Master.

      Tiene que declararse AQUÍ y no con -p: en la línea de comandos: los targets que
      generan resources.pri lo leen antes, y con la propiedad puesta sólo por línea de
      comandos el PRI queda sin los recursos de tema de WinUI. La aplicación compila,
      pero al arrancar muere con:
        Cannot locate resource from 'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'

      Para generar un MSIX firmado: dotnet publish -p:WindowsPackageType=MSIX
    -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Avacom.OPS.Core\Avacom.OPS.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#ECF5F8" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#ECF5F8" BaseSize="128,128" />

    <!-- El SVG se rasteriza en tiempo de compilación y se referencia como .png.
         El nombre no puede llevar guiones: MAUI aplica las reglas de nombres de
         recurso de Android, así que el archivo es avacom_logo.svg.
         BaseSize amplía el original de 71x19 para que no se vea borroso al
         mostrarlo más grande ni en pantallas de alta densidad. -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\avacom_logo.svg" BaseSize="284,76" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>
</Project>
