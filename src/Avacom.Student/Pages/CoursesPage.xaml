<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Avacom.OPS.Core.Models;assembly=Avacom.OPS.Core"
             xmlns:vm="clr-namespace:Avacom.Student.ViewModels"
             x:Class="Avacom.Student.Pages.CoursesPage"
             x:DataType="vm:CoursesViewModel"
             Background="{StaticResource PageGradient}">
    <Grid Padding="{OnIdiom Desktop=34, Tablet=26, Phone=16}" RowDefinitions="Auto,*" RowSpacing="22">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Image Source="avacom_logo.png" HeightRequest="{OnIdiom Desktop=42, Tablet=40, Phone=34}" WidthRequest="{OnIdiom Desktop=160, Tablet=150, Phone=126}" Aspect="AspectFit" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding StudentName, StringFormat='Hola, {0}'}" FontAttributes="Bold" /><Label Text="{Binding ConnectionLabel}" TextColor="{StaticResource Muted}" FontSize="11" LineBreakMode="TailTruncation" /></VerticalStackLayout>
            <Button Grid.Column="2" Text="Salir" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout MaximumWidthRequest="1100" HorizontalOptions="Center" Spacing="22" Padding="0,4,0,28">
                <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="MIS CURSOS" Style="{StaticResource Eyebrow}" /><Label Text="¿Qué aprenderás hoy?" Style="{StaticResource PageTitle}" /></VerticalStackLayout><Button Grid.Column="1" Text="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" /></Grid>
                <Label Text="{Binding Status}" TextColor="{StaticResource Muted}" />

                <!-- Lo que el docente acaba de repartir desde la pantalla del aula.
                     Va arriba de los cursos porque es lo que hay que mirar ahora. -->
                <Border IsVisible="{Binding HayMaterialDeClase}" Style="{StaticResource SoftCard}" Padding="24">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="MATERIAL DE LA CLASE" Style="{StaticResource Eyebrow}" />
                        <CollectionView ItemsSource="{Binding MaterialDeClase}" SelectionMode="None">
                            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:MaterialParaEstudiante">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <Border WidthRequest="56" HeightRequest="56" BackgroundColor="#E6F4FB" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                            <Label Text="&#9636;" TextColor="{StaticResource Info}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding KindLabel}" Style="{StaticResource Eyebrow}" />
                                            <Label Text="{Binding DisplayTitle}" FontSize="19" FontAttributes="Bold" />
                                            <!-- Cuando el material sale del equipo, esto lo explica en vez
                                                 de que la tarjeta desaparezca sin motivo. -->
                                            <Label Text="{Binding StateLabel}" FontSize="13" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <CollectionView ItemsSource="{Binding Courses}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Desktop=2, Tablet=2, Phone=1}"
                                         VerticalItemSpacing="16" HorizontalItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Course">
                            <Border Style="{StaticResource SoftCard}" Margin="0,8">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="{OnIdiom Desktop='110,*,Auto', Tablet='90,*,Auto', Phone='74,*'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="18" RowSpacing="12">
                                    <Border WidthRequest="{OnIdiom Desktop=92, Tablet=78, Phone=66}" HeightRequest="{OnIdiom Desktop=92, Tablet=78, Phone=66}" BackgroundColor="#FDEBEC" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape><Label Text="∑" TextColor="{StaticResource Primary}" FontSize="{OnIdiom Desktop=38, Tablet=32, Phone=28}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center"><HorizontalStackLayout Spacing="8"><Label Text="{Binding Framework.Name}" Style="{StaticResource Eyebrow}" /><Label Text="{Binding StatusLabel}" TextColor="{StaticResource Success}" FontSize="11" /></HorizontalStackLayout><Label Text="{Binding Title}" FontSize="{OnIdiom Desktop=24, Tablet=22, Phone=19}" FontAttributes="Bold" /><Label Text="{Binding Description}" TextColor="{StaticResource Muted}" MaxLines="2" FontSize="13" /><Label Text="{Binding Summary}" TextColor="{StaticResource Info}" FontAttributes="Bold" FontSize="12" /></VerticalStackLayout>
                                    <Button Grid.Column="{OnIdiom Phone=0, Default=2}" Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}" Text="Abrir curso" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
