<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Avacom.Student.ViewModels"
             x:Class="Avacom.Student.Pages.RegistrationPage"
             x:DataType="vm:RegistrationViewModel"
             Background="{StaticResource PageGradient}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="{OnIdiom Desktop=40, Tablet=32, Phone=18}" RowDefinitions="*">
            <Border Style="{StaticResource SoftCard}" Padding="{OnIdiom Desktop=40, Tablet=34, Phone=22}"
                    MaximumWidthRequest="620" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="24">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="AVACOM STUDENT" Style="{StaticResource Eyebrow}" />
                        <Label Text="¿Quién eres?" Style="{StaticResource PageTitle}" />
                        <Label Text="Escribe tu nombre y la dirección del equipo del aula."
                               TextColor="{StaticResource Muted}" FontSize="14" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tu nombre" TextColor="{StaticResource Muted}" FontSize="13" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Name}" Placeholder="Ej. Sofía Ramírez"
                                   FontSize="{OnIdiom Desktop=17, Tablet=19, Phone=16}"
                                   HeightRequest="{OnIdiom Tablet=62, Default=56}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Equipo del aula" TextColor="{StaticResource Muted}" FontSize="13" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding ServerUrl}" Placeholder="192.168.0.29:8000"
                                   Keyboard="Url"
                                   FontSize="{OnIdiom Desktop=17, Tablet=19, Phone=16}"
                                   HeightRequest="{OnIdiom Tablet=62, Default=56}" />
                        </Border>

                        <!--
                          El semáforo. Es lo único que un alumno delante de una
                          tableta que no conecta puede usar para saber qué pasa,
                          así que va grande y con el motivo debajo.
                        -->
                        <Border Padding="18,14" BackgroundColor="#F3F7F7" StrokeThickness="0" Margin="0,6,0,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Ellipse WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Fill="#A1A1AA">
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding ConnectionLabel}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource Muted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Status}" TextColor="{StaticResource Muted}"
                                           FontSize="13" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Comprobar conexión" Command="{Binding CheckCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="{OnIdiom Tablet=64, Default=58}" />

                    <!-- Entrar solo se enciende con conexión verificada y un nombre escrito. -->
                    <Button Text="Entrar" Command="{Binding EnterCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="{OnIdiom Tablet=68, Default=62}"
                            FontSize="{OnIdiom Tablet=19, Default=17}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}" />

                    <Label Text="Esta aplicación solo consulta. No puede instalar, cambiar ni borrar contenido."
                           TextColor="{StaticResource Muted}" FontSize="11"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
