# Copia este archivo como .env en la raíz del repositorio y ajústalo por sede.
# El .env NO se versiona. Lo lee exam_master/settings.py al arrancar, así que no
# hace falta exportar nada a mano ni usar Docker.
#
#   Copy-Item .env.example .env

# Genera una clave propia por instalación, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-only-for-the-prototype

# 0 para la instalación: con DEBUG=1 un error 500 devuelve la traza completa a
# cualquier dispositivo de la LAN. Usa 1 sólo mientras desarrollas.
DJANGO_DEBUG=0

# El Master se alcanza por su IP de LAN, que cambia por sede. Puedes restringirlo
# a la IP concreta del día, por ejemplo: 192.168.1.10,127.0.0.1
DJANGO_ALLOWED_HOSTS=*

# WARNING sólo deja errores en consola; INFO traza cada conexión y respuesta.
DJANGO_LOG_LEVEL=INFO

# El prototipo replica en SQLite el modelo de datos entregado. No necesita
# MongoDB, PostgreSQL ni otro servicio instalado.
DB_ENGINE=sqlite

API_PORT=8000

# El PIN de recuperación administrativa NO se configura aquí: vive únicamente en
# cada dispositivo cliente (IEmergencyRecoveryService.ChangePin) para que el
# backend nunca lo conozca y para no versionarlo. Ver README, "Recuperación
# administrativa local".
